# Sanal ortam
.venv/

# Koşu çıktıları
outputs/
# Benchmark pipeline koşu çıktıları (yeniden üretilebilir; küratörlü results/*.json + figures/ izlenir)
benchmark/results/run_*/
# Rakip araç ham çıktıları (yeniden üretilebilir; küratörlü vaxforge_summary.json + *_headtohead.json izlenir)
benchmark/results/*/nerve/
benchmark/results/*/vaxignml/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# İndirilen lisanslı/büyük araçlar, modeller, veritabanları (repoya konmaz)
# NetMHCpan/NetMHCIIpan/SignalP/TMHMM/BepiPred/DeepLoc/IApred + VFDB/insan/allergen DB
tools/
!tools/README.md

# Önbellekler
*.pkl
.cache/
.DS_Store

# Araç geçici çıktıları (SignalP/TMHMM vb. cwd'ye yazabilir)
Sequence_*
plot/

# Benchmark ara indirme dosyaları (repoda yalnız işlenmiş *_proteome.faa tutulur)
data/validation/*_cds.faa
data/validation/*.gb
# Türetilmiş/geçici FASTA'lar (prep_proteome.py ile *_proteome.faa'dan yeniden üretilir)
data/validation/*_prepared.faa
data/validation/*_prepared_vaxign.faa
data/validation/*_vaxign.faa
data/validation/*_smoke.faa

# Üretilen Word çıktıları (benchmark/md_to_docx.py ile *.md'den yeniden üretilir)
benchmark/*.docx

# Araç/lint önbellekleri
.pytest_cache/
.ruff_cache/

# Yayıncıdan indirilen ek dosyalar (Leptospira etiket kaynakları).
# Telif yayıncıya aittir ve dosyalar GÜVENİLMEYEN VERİDİR → repoya konmaz.
# Yeniden üretmek için: python3 scripts/fetch_lepto_labels.py
# İzlenen tek dosya manifest.json (hangi kaynak indi/erişilemedi kaydı).
data/labels/*/*/
